# Copie para .env.local (ignorado pelo Git) e preencha.
# Em produção, defina as mesmas variáveis no painel da hospedagem (Cloud Run, Render…).

# Neon > Connect > (Connection pooling ligado) > copie o endereço
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinar os tokens de login (mínimo 32 caracteres, aleatório).
JWT_SECRET=""

# Opcional: cria o primeiro administrador na primeira inicialização. Depois pode apagar.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Opcional: aviso por e-mail a cada novo agendamento (Gmail: use uma "senha de app",
# criada em https://myaccount.google.com/apppasswords — requer verificação em 2 etapas).
NOTIFY_EMAIL=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT="587"
# MAIL_FROM=""

# Opcionais
# CORS_ALLOWED_ORIGINS="http://localhost:4200,https://seusite.vercel.app"
# JWT_TTL="8h"
# APP_TIMEZONE="America/Sao_Paulo"
